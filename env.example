CURSOR_API_KEY=your_cursor_api_key
GITHUB_TOKEN=your_github_token_with_repo_scope

# Optional: prompt config defaults (CLI flags override these)
# PROMPT_CONFIG_OWNER=your_github_username_or_org

# Optional: CI / GitHub Actions wait + auto-fix loop after PR submission
# CI_FIX_MAX_ATTEMPTS=2
# CI_WAIT_TIMEOUT_SECONDS=1800
# CI_WAIT_POLL_SECONDS=15
# CI_ACCEPTABLE_CONCLUSIONS=success,skipped,neutral
# CI_MAX_LOG_BYTES=5000000
# CI_MAX_LOG_CHARS=30000

# Optional: choose how to run cursor-agent ("docker" or "cli"). Default is "docker".
# CURSOR_RUNNER=cli
# Optional: model used by cursor-agent (default: gpt-5.2).
# CURSOR_MODEL=gpt-5.2
# Optional: enable/disable cursor output streaming to console (default: true).
# Set to false to reduce verbose output in logs.
# CURSOR_STREAM_OUTPUT=false
# Optional: comma-separated env keys forwarded into the agent environment.
# Default: CURSOR_API_KEY
# CURSOR_ENV_KEYS=CURSOR_API_KEY
# Optional: when streaming output is enabled, include thinking output (default: off).
# CURSOR_STREAM_SHOW_THINKING=true
# Optional: cursor-agent binary when using CURSOR_RUNNER=cli.
# CURSOR_CLI_BIN=cursor-agent
# Optional: workspace root passed to cursor-agent when using CURSOR_RUNNER=cli.
# CURSOR_WORKSPACE_ROOT=/absolute/path

# Optional: where to write per-run raw cursor-agent output logs.
# Default: ~/.pr-creator/cursor-output-logs
# PR_CREATOR_CURSOR_OUTPUT_LOG_DIR=~/.pr-creator/cursor-output-logs

# Optional: Docker image when using CURSOR_RUNNER=docker.
# CURSOR_IMAGE=leonpatmore2/cursor-agent:latest

# Optional: pydantic-ai model used by the orchestration step (default: openai:gpt-5.2).
# ORCHESTRATOR_MODEL=openai:gpt-5.2

# Optional: MCP servers configuration file path (enables orchestrator to access external tools).
# See examples/mcp-servers.json for GitHub MCP server example.
# MCP_CONFIG=~/.pr-creator/mcp-servers.json
